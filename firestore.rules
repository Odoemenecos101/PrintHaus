      allow create: if isValidId(orderId)
        && isVerifiedUser()
        && isValidOrderRecord(incoming())
        && incoming().id == orderId
        && incoming().studentUid == request.auth.uid
        && incoming().status == 'order_received'
        && incoming().paymentStatus == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(orderId)
        && isAdmin()
        && isValidOrderRecord(incoming())
        && incoming().id == existing().id
        && incoming().studentUid == existing().studentUid
        && incoming().studentId == existing().studentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;