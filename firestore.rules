rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'chukwuemekaodoemene@gmail.com'
      );
    }

    // --- UserProfile Validation Blueprint ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'name', 'email', 'matricNumber', 'school',
          'department', 'residency', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'matricNumber', 'school',
          'department', 'residency', 'hostelGender', 'hostelName',
          'role', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.matricNumber is string && data.matricNumber.size() >= 2 && data.matricNumber.size() <= 40
        && data.school is string && data.school.size() >= 1 && data.school.size() <= 120
        && data.department is string && data.department.size() >= 1 && data.department.size() <= 120
        && data.residency in ['on-campus', 'off-campus']
        && (!('hostelGender' in data) || data.hostelGender in ['male', 'female'])
        && (!('hostelName' in data) || (data.hostelName is string && data.hostelName.size() >= 1 && data.hostelName.size() <= 120))
        && data.role in ['student', 'staff', 'admin']
        && data.status in ['active', 'suspended']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- AdminRole Validation Blueprint ---
    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    // --- StudentOrderRecord Validation Blueprint ---
    function isValidOrderRecord(data) {
      return data.keys().hasAll([
          'id', 'orderCode', 'collectionCode', 'studentUid', 'studentId',
          'studentName', 'studentEmail', 'matricNumber', 'fileName',
          'totalPages', 'totalDocuments', 'totalAmount', 'pickupVenue',
          'paymentMethod', 'paymentStatus', 'paymentReference', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderCode', 'collectionCode', 'studentUid', 'studentId',
          'studentName', 'studentEmail', 'matricNumber', 'fileName',
          'totalPages', 'totalDocuments', 'totalAmount', 'pickupVenue',
          'paymentMethod', 'paymentStatus', 'paymentReference', 'status',
          'pickupShelf', 'itemsSummary', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.orderCode is string && data.orderCode.size() >= 1 && data.orderCode.size() <= 32
        && data.collectionCode is string && data.collectionCode.size() >= 1 && data.collectionCode.size() <= 32
        && isValidId(data.studentUid)
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 160
        && data.matricNumber is string && data.matricNumber.size() >= 1 && data.matricNumber.size() <= 40
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200
        && data.totalPages is number && data.totalPages >= 1
        && data.totalDocuments is number && data.totalDocuments >= 1
        && data.totalAmount is number && data.totalAmount >= 0
        && data.pickupVenue is string && data.pickupVenue.size() >= 1 && data.pickupVenue.size() <= 120
        && data.paymentMethod in ['paystack_card', 'bank_transfer', 'campus_wallet']
        && data.paymentStatus in ['pending', 'confirmed', 'refunded']
        && data.paymentReference is string && data.paymentReference.size() >= 1 && data.paymentReference.size() <= 64
        && data.status in [
          'order_received', 'payment_confirmed', 'printing_in_progress',
          'quality_check', 'ready_for_collection', 'collected', 'rejected'
        ]
        && (!('pickupShelf' in data) || data.pickupShelf == null || (data.pickupShelf is string && data.pickupShelf.size() <= 64))
        && (!('itemsSummary' in data) || (data.itemsSummary is string && data.itemsSummary.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().role == 'student'
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().email == existing().email
            && incoming().role == existing().role
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'matricNumber', 'school', 'department',
              'residency', 'hostelGender', 'hostelName', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // --- Collection: /admins/{userId} ---
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isAdmin()
        && isValidAdminRole(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // --- Collection: /orders/{orderId} ---
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() || (isVerifiedUser() && existing().studentUid == request.auth.uid)
      );
      allow list: if isAdmin() || (isVerifiedUser() && existing().studentUid == request.auth.uid);

     allow create: if isValidId(orderId)
  && isVerifiedUser()
  && isValidOrderRecord(incoming())
  && incoming().id == orderId
  && incoming().studentUid == request.auth.uid
  && incoming().status == 'order_received'
  && incoming().paymentStatus == 'pending'
  && incoming().createdAt == request.time
  && incoming().updatedAt == request.time;
  
allow update: if isValidId(orderId)
  && isAdmin()
  && isValidOrderRecord(incoming())
  && incoming().id == existing().id
  && incoming().studentUid == existing().studentUid
  && incoming().studentId == existing().studentId
  && incoming().createdAt == existing().createdAt
  && incoming().updatedAt == request.time;

      allow delete: if isValidId(orderId) && isAdmin();
    }
  }
}
