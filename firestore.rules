rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Security Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isActiveAuthAccount() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'chukwuemekaodoemene@gmail.com')
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'name',
          'email',
          'matricNumber',
          'school',
          'department',
          'residency',
          'role',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'matricNumber',
          'school',
          'department',
          'residency',
          'hostelGender',
          'hostelName',
          'role',
          'roles',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.matricNumber is string && data.matricNumber.size() >= 2 && data.matricNumber.size() <= 40
        && data.school is string && data.school.size() >= 1 && data.school.size() <= 120
        && data.department is string && data.department.size() >= 1 && data.department.size() <= 120
        && data.residency in ['on-campus', 'off-campus']
        && (!('hostelGender' in data) || data.hostelGender in ['male', 'female'])
        && (!('hostelName' in data) || (data.hostelName is string && data.hostelName.size() >= 1 && data.hostelName.size() <= 120))
        && data.role in ['student', 'staff', 'admin']
        && (!('roles' in data) || (
          data.roles is list
          && data.roles.size() >= 1
          && data.roles.size() <= 3
          && data.roles[0] is string
          && data.roles.hasOnly(['student', 'staff', 'admin'])
        ))
        && data.status in ['active', 'suspended']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidOrderRecord(data) {
      return data.keys().hasAll([
          'id',
          'orderCode',
          'collectionCode',
          'studentUid',
          'studentId',
          'studentName',
          'studentEmail',
          'matricNumber',
          'fileName',
          'totalPages',
          'totalDocuments',
          'totalAmount',
          'pickupVenue',
          'paymentMethod',
          'paymentStatus',
          'paymentReference',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'orderCode',
          'collectionCode',
          'qrReference',
          'studentUid',
          'studentId',
          'studentName',
          'studentEmail',
          'matricNumber',
          'fileName',
          'totalPages',
          'totalDocuments',
          'totalAmount',
          'pickupVenue',
          'paymentMethod',
          'paymentStatus',
          'paymentReference',
          'status',
          'pickupShelf',
          'itemsSummary',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.orderCode is string && data.orderCode.size() >= 1 && data.orderCode.size() <= 32
        && data.collectionCode is string && data.collectionCode.size() >= 1 && data.collectionCode.size() <= 32
        && (!('qrReference' in data) || (data.qrReference is string && data.qrReference.size() >= 1 && data.qrReference.size() <= 64))
        && isValidId(data.studentUid)
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 160
        && data.matricNumber is string && data.matricNumber.size() >= 1 && data.matricNumber.size() <= 40
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200
        && data.totalPages is number && data.totalPages >= 1
        && data.totalDocuments is number && data.totalDocuments >= 1
        && data.totalAmount is number && data.totalAmount >= 0
        && data.pickupVenue is string && data.pickupVenue.size() >= 1 && data.pickupVenue.size() <= 120
        && data.paymentMethod in ['paystack_card', 'bank_transfer', 'campus_wallet']
        && data.paymentStatus in ['pending', 'confirmed', 'refunded']
        && data.paymentReference is string && data.paymentReference.size() >= 1 && data.paymentReference.size() <= 64
        && data.status in [
          'order_received',
          'payment_confirmed',
          'printing_in_progress',
          'quality_check',
          'ready_for_collection',
          'collected',
          'rejected'
        ]
        && (!('pickupShelf' in data) || (data.pickupShelf is string && data.pickupShelf.size() >= 1 && data.pickupShelf.size() <= 64))
        && (!('itemsSummary' in data) || (data.itemsSummary is string && data.itemsSummary.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isActiveAuthAccount()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().role == 'student'
        && (!('roles' in incoming()) || incoming().roles == ['student'])
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && (
          (
            isAdmin()
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
          ) || (
            isActiveAuthAccount()
            && isOwner(userId)
            && incoming().uid == existing().uid
            && incoming().email == existing().email
            && incoming().role == existing().role
            && ((!('roles' in existing()) && !('roles' in incoming())) || ('roles' in existing() && 'roles' in incoming() && incoming().roles == existing().roles))
            && incoming().status == existing().status
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'matricNumber',
              'school',
              'department',
              'residency',
              'hostelGender',
              'hostelName',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isAdmin()
        && isValidAdminRole(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().studentUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.studentUid == request.auth.uid || isAdmin());

      allow create: if isValidId(orderId)
        && isActiveAuthAccount()
        && isValidOrderRecord(incoming())
        && incoming().id == orderId
        && incoming().studentUid == request.auth.uid
        && (!('qrReference' in incoming()) || (incoming().qrReference is string && incoming().qrReference.size() >= 1 && incoming().qrReference.size() <= 64))
        && (
          (incoming().status == 'order_received' && incoming().paymentStatus == 'pending')
          || (
            incoming().status == 'payment_confirmed'
            && incoming().paymentStatus == 'confirmed'
            && incoming().paymentMethod in ['paystack_card', 'campus_wallet']
          )
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(orderId)
        && isValidOrderRecord(incoming())
        && incoming().id == existing().id
        && incoming().studentUid == existing().studentUid
        && incoming().studentId == existing().studentId
        && ((!('qrReference' in existing()) && !('qrReference' in incoming())) || ('qrReference' in existing() && 'qrReference' in incoming() && incoming().qrReference == existing().qrReference))
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isActiveAuthAccount()
            && existing().studentUid == request.auth.uid
            && !(existing().status in ['collected', 'rejected'])
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'paymentStatus',
              'pickupShelf',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(orderId) && isAdmin();
    }
  }
}