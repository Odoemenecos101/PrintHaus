{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Cross-device PrintHaus user profile linked to Firebase Authentication UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "matricNumber": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "school": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "residency": {
          "type": "string",
          "enum": ["on-campus", "off-campus"]
        },
        "hostelGender": {
          "type": "string",
          "enum": ["male", "female"]
        },
        "hostelName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["student", "staff", "admin"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "matricNumber",
        "school",
        "department",
        "residency",
        "role",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted admin role mapping keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "StudentOrderRecord": {
      "title": "StudentOrderRecord",
      "description": "Print order summary synced to Firestore for cross-device student access.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "collectionCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "studentEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "matricNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "totalPages": {
          "type": "number"
        },
        "totalDocuments": {
          "type": "number"
        },
        "totalAmount": {
          "type": "number"
        },
        "pickupVenue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["paystack_card", "bank_transfer", "campus_wallet"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "confirmed", "refunded"]
        },
        "paymentReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "order_received",
            "payment_confirmed",
            "printing_in_progress",
            "quality_check",
            "ready_for_collection",
            "collected",
            "rejected"
          ]
        },
        "pickupShelf": {
          "type": "string",
          "maxLength": 64
        },
        "itemsSummary": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "orderCode",
        "collectionCode",
        "studentUid",
        "studentId",
        "studentName",
        "studentEmail",
        "matricNumber",
        "fileName",
        "totalPages",
        "totalDocuments",
        "totalAmount",
        "pickupVenue",
        "paymentMethod",
        "paymentStatus",
        "paymentReference",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Cross-device PrintHaus student/user profiles indexed by Firebase Auth UID."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminRole"
      },
      "description": "Trusted admin role documents."
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/StudentOrderRecord"
      },
      "description": "Synced print order records scoped to the student Firebase UID."
    }
  }
}
